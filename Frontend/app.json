{
  "expo": {
    "name": "와글와글",
    "slug": "waglewagle-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "waglewagle",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "android": {
      "package": "com.waglewagle.mobile",
      "adaptiveIcon": {
        "backgroundColor": "#FAFAFA"
      },
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "i15a606.p.ssafy.io",
              "pathPrefix": "/oauth/callback"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ]
    },
    "plugins": [
      "expo-router",
      "expo-video",
      "expo-secure-store",
      "expo-web-browser",
      "expo-font"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "4b468b20-9f5b-451e-8038-991c9bdf05b7"
      }
    }
  }
}
