{
  "expo": {
    "name": "와글와글",
    "slug": "waglewagle-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "waglewagle",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "android": {
      "package": "com.waglewagle.mobile",
      "adaptiveIcon": {
        "backgroundColor": "#FAFAFA"
      }
    },
    "plugins": [
      "expo-router",
      "expo-video",
      [
        "expo-camera",
        {
          "cameraPermission": "현장 영상을 촬영하려면 카메라 접근이 필요해요.",
          "microphonePermission": "현장 소리를 함께 담으려면 마이크 접근이 필요해요.",
          "recordAudioAndroid": true
        }
      ],
      "expo-font"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "4b468b20-9f5b-451e-8038-991c9bdf05b7"
      }
    }
  }
}
