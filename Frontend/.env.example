EXPO_PUBLIC_API_BASE_URL=
# true 로 두면 서버 대신 src/mocks 고정 데이터를 사용한다. 베이스 URL이 비어 있으면 자동 적용된다.
# 목업 모드에서는 소셜 로그인도 브라우저를 열지 않고 고정 응답(온보딩 필요)으로 처리한다.
EXPO_PUBLIC_USE_MOCK_API=true
# 카카오 개발자 콘솔 > 내 애플리케이션 > 앱 키 > JavaScript 키
# Expo는 EXPO_PUBLIC_ 접두사가 붙은 값만 앱 번들에 주입한다.
EXPO_PUBLIC_KAKAOMAP_APPKEY=
# 카카오 개발자 콘솔 > 내 애플리케이션 > 앱 키 > REST API 키 (위 지도 키와 다른 값)
# 브라우저 방식이라 이 키만 있으면 되고 Android 키 해시 등록은 필요 없다.
EXPO_PUBLIC_KAKAO_REST_API_KEY=
# 네이버 개발자센터 > 내 애플리케이션 > 애플리케이션 정보 > Client ID
# Client Secret은 서버만 가진다. 앱 번들에 넣으면 그대로 노출되므로 절대 추가하지 않는다.
EXPO_PUBLIC_NAVER_CLIENT_ID=
