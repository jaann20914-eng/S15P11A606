# infra/monitoring/docker-compose.yml 이 사용하는 비밀값.
# 이 파일을 복사해 infra/monitoring/.env 를 만들고 실제 값을 채운다.
#   cp infra/monitoring/.env.example infra/monitoring/.env
# .env 는 git 에 커밋하지 않는다 (.gitignore 처리됨).

# Grafana admin 계정 초기 비밀번호 (사용자명은 admin)
GRAFANA_ADMIN_PASSWORD=change-me

# postgres-exporter 가 waggle-postgis 에 접속할 비밀번호.
# infra/.env 의 POSTGRES_PASSWORD 와 반드시 동일해야 한다(운영 중인 DB 비번).
POSTGRES_PASSWORD=change-me
