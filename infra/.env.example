# infra/docker-compose.yml 이 사용하는 비밀값.
# 이 파일을 복사해 infra/.env 를 만들고 실제 값을 채운다.
#   cp infra/.env.example infra/.env
# infra/.env 는 git 에 커밋하지 않는다 (.gitignore 처리됨).
#
# 주의: 아래 값은 "현재 운영 중인 컨테이너에 설정된 값과 반드시 동일"해야 한다.
#       기존 데이터 볼륨을 그대로 재사용하기 때문이다.

POSTGRES_PASSWORD=change-me
RABBITMQ_DEFAULT_PASS=change-me
