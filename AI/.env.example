# core/config.py가 읽는 환경변수 템플릿.
# 이 파일을 .env로 복사한 뒤 실제 값을 채웁니다. .env는 커밋하지 않습니다.

# Back이 AI를 호출할 때 보내는 x-internal-api-key 검증값
INTERNAL_API_KEY=
# AI가 Back을 호출할 때 X-Internal-Secret으로 보내는 값. Back의 INTERNAL_API_SECRET과 같아야 합니다.
INTERNAL_API_SECRET=

LOG_LEVEL=INFO

# Recommendation
# 추천 점수 계산 제한 시간. 초과하면 504 SCORING_TIMEOUT으로 응답합니다.
SCORING_TIMEOUT_MS=2000

# Chat risk callback
# 채팅 패턴 분석 결과를 보낼 Back 서버 주소.
BACK_BASE_URL=http://localhost:8080
# 콜백 응답 제한 시간과 재시도 횟수. 최초 1회 + 재시도 2회 = 최대 3회 전송합니다.
CHAT_CALLBACK_TIMEOUT_SECONDS=3.0
CHAT_CALLBACK_MAX_RETRIES=2

# Chat risk analysis
# Gemini API 키. 채팅 분석 워커만 사용하며, 비어 있으면 분석이 FAILED로 끝납니다.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
# 기본 엔드포인트를 쓰려면 비워 둡니다.
GEMINI_BASE_URL=
GEMINI_TIMEOUT_SECONDS=10.0
# 분석 실패 시 재시도 횟수. 최초 1회 + 재시도 2회 = 최대 3회 호출합니다.
CHAT_ANALYSIS_MAX_RETRIES=2


# RabbitMQ
RABBITMQ_URL=amqp://guest:guest@localhost:5672/
BLUR_EXCHANGE=ai.blur.exchange
BLUR_REQUEST_QUEUE=ai.blur.request
BLUR_REQUEST_ROUTING_KEY=ai.blur.request
BLUR_RESULT_QUEUE=ai.blur.result
BLUR_RESULT_ROUTING_KEY=ai.blur.result
BLUR_DLX=ai.blur.dlx
BLUR_DEAD_LETTER_QUEUE=ai.blur.dead-letter
BLUR_DEAD_LETTER_ROUTING_KEY=ai.blur.dead-letter
CHAT_EXCHANGE=ai.chat.exchange
CHAT_MESSAGE_QUEUE=ai.chat.message
CHAT_MESSAGE_ROUTING_KEY=ai.chat.message
CHAT_DLX=ai.chat.dlx
CHAT_DEAD_LETTER_QUEUE=ai.chat.dead-letter
CHAT_DEAD_LETTER_ROUTING_KEY=ai.chat.dead-letter

# Redis and worker idempotency (disabled: ai_blur_job DB UNIQUE 사용)
# REDIS_URL=redis://localhost:6379/0
# REDIS_SOCKET_TIMEOUT_SECONDS=5.0
# IDEMPOTENCY_KEY_PREFIX=ai:blur:job:
# IDEMPOTENCY_RETENTION_SECONDS=604800
# WORKER_ID=blur-worker
# JOB_LEASE_SECONDS=300
# JOB_LEASE_RENEW_INTERVAL_SECONDS=60
# BUSY_REQUEUE_DELAY_SECONDS=2.0

# Object Storage
STORAGE_ENDPOINT_URL=
STORAGE_BUCKET=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
STORAGE_REGION=ap-northeast-2

# SCRFD
MODEL_NAME=buffalo_m
DET_THRESHOLD=0.3
DET_WIDTH=640
DET_HEIGHT=640

# Blur
MARGIN_RATIO=0.3
BLUR_KERNEL_SIZE=51
BLUR_ITERATIONS=2

# Face tracking
TRACKING_MAX_MISSED_FRAMES=3
TRACKING_IOU_THRESHOLD=0.3
TRACKING_SMOOTHING_ALPHA=0.3

# Validation
VALIDATE_INTERVAL=5
MAX_SHARPNESS_RATIO=0.6
MIN_ROI_SIZE=8
