# core/config.py가 읽는 환경변수 템플릿.
# 이 파일을 .env로 복사한 뒤 실제 값을 채웁니다. .env는 커밋하지 않습니다.

# Back <-> AI 내부 통신에 쓰는 x-internal-api-key
INTERNAL_API_KEY=

LOG_LEVEL=INFO

# Recommendation
# 추천 점수 계산 제한 시간. 초과하면 504 SCORING_TIMEOUT으로 응답합니다.
SCORING_TIMEOUT_MS=2000


# RabbitMQ
RABBITMQ_URL=amqp://guest:guest@localhost:5672/
BLUR_EXCHANGE=ai.blur.exchange
BLUR_REQUEST_QUEUE=ai.blur.request
BLUR_REQUEST_ROUTING_KEY=ai.blur.request
BLUR_RESULT_QUEUE=ai.blur.result
BLUR_RESULT_ROUTING_KEY=ai.blur.result
BLUR_DLX=ai.blur.dlx
BLUR_DEAD_LETTER_QUEUE=ai.blur.dead-letter
BLUR_DEAD_LETTER_ROUTING_KEY=ai.blur.dead-letter

# Redis and worker idempotency (disabled: ai_blur_job DB UNIQUE 사용)
# REDIS_URL=redis://localhost:6379/0
# REDIS_SOCKET_TIMEOUT_SECONDS=5.0
# IDEMPOTENCY_KEY_PREFIX=ai:blur:job:
# IDEMPOTENCY_RETENTION_SECONDS=604800
# WORKER_ID=blur-worker
# JOB_LEASE_SECONDS=300
# JOB_LEASE_RENEW_INTERVAL_SECONDS=60
# BUSY_REQUEUE_DELAY_SECONDS=2.0

# Object Storage
STORAGE_ENDPOINT_URL=
STORAGE_BUCKET=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
STORAGE_REGION=ap-northeast-2

# SCRFD
MODEL_NAME=buffalo_sc
DET_THRESHOLD=0.3
DET_WIDTH=640
DET_HEIGHT=640

# Blur
MARGIN_RATIO=0.3
BLUR_KERNEL_SIZE=51
BLUR_ITERATIONS=2

# Validation
VALIDATE_INTERVAL=5
MAX_SHARPNESS_RATIO=0.6
MIN_ROI_SIZE=8
